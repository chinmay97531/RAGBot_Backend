# Server port
PORT=3000

# OpenAI API key (embeddings + LLM fallback if Anthropic/Gemini are unset)
OPENAI_API_KEY=your_openai_api_key
# Optional: override chat model when using OpenAI as LLM (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Anthropic API key (for the Claude model)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Gemini API Key (for the Gemini model)
GEMINI_API_KEY=your_gemini_api_key
# Optional: override model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Supadata API key (for fetching YouTube transcripts)
SUPADATA_API_KEY=your_supadata_api_key

# PostgreSQL connection URL with pgvector enabled
DATABASE_API_KEY=postgres://username:password@host:port/dbname
